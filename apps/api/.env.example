# ⚠️  ESTE ARCHIVO VA AL REPO. No pongas valores reales aquí.
#     Los secretos van en .env, que sí está en .gitignore:
#
#         cp .env.example .env      # y llenas .env, no este
#
OPENROUTER_API_KEY=sk-or-v1-...
CURUBA_MODEL=openrouter:anthropic/claude-sonnet-5

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# El WhatsApp Sender aprobado (display name "Curuba"), con el prefijo
# whatsapp: y en E.164. Ojo: es un número +1, no +57.
TWILIO_WHATSAPP_FROM=whatsapp:+12603057633

# false mientras se prueba en local (Twilio no está firmando nada).
# true en Railway, una vez el resto ya funcione.
VALIDATE_TWILIO_SIGNATURE=false
