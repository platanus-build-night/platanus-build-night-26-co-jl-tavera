# ⚠️  ESTE ARCHIVO VA AL REPO. No pongas valores reales aquí.
#     Los secretos van en .env, que sí está en .gitignore:
#
#         cp .env.example .env      # y llenas .env, no este
#
OPENROUTER_API_KEY=sk-or-v1-...
CURUBA_MODEL=openrouter:anthropic/claude-sonnet-5

# Búsqueda web: marca comercial -> principio activo, y precios de droguería.
# NO necesita llave nueva, sale por la misma OPENROUTER_API_KEY. `sonar-pro` es
# 3x/15x más caro y trae más fuentes; para la demo alcanza `sonar`. Las dos
# cobran además $0.005 fijos por búsqueda, aparte de los tokens.
CURUBA_WEB_MODEL=openrouter:perplexity/sonar
CURUBA_WEB_TIMEOUT=25

# En Railway va como REFERENCIA, en las variables del servicio de la API:
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
# Acá en local va la URL PÚBLICA — la encuentras como DATABASE_PUBLIC_URL en
# las variables del servicio de Postgres. La privada (.railway.internal) solo
# resuelve dentro de Railway.
DATABASE_URL=postgresql://postgres:CONTRASENA@nombre.proxy.rlwy.net:PUERTO/railway

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# El WhatsApp Sender aprobado (display name "Curuba"), con el prefijo
# whatsapp: y en E.164. Ojo: es un número +1, no +57.
TWILIO_WHATSAPP_FROM=whatsapp:+12603057633

# false mientras se prueba en local (Twilio no está firmando nada).
# true en Railway, una vez el resto ya funcione.
VALIDATE_TWILIO_SIGNATURE=false

# Con esto se arman los enlaces de los PDF que Twilio descarga para adjuntarlos.
# En Railway va la URL pública del servicio de la API; en local, la de ngrok.
# SIN barra al final: los enlaces se arman como f"{base}/f/{id}".
PUBLIC_BASE_URL=https://curuba-platanus-production.up.railway.app
